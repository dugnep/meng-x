# 点子铺后端 systemd 服务
# 安装位置: /etc/systemd/system/meng-x.service
# 常用命令: systemctl start|stop|restart|status meng-x

[Unit]
Description=Meng-X Server (Spring Boot)
After=network.target

[Service]
Type=simple
# 与部署用户一致：CI 上传 jar 到 /opt/meng-x/ 后可直接重启，无权限问题
User=mengx
WorkingDirectory=/opt/meng-x
# 4G 内存机器：堆固定 1G，给 PostgreSQL / 系统留余量，避免堆伸缩抖动
ExecStart=/usr/bin/java -Xms512m -Xmx1g -jar /opt/meng-x/meng-x-server.jar
Restart=on-failure
RestartSec=5

# 生产密钥（DB 密码、JWT 密钥等）由 server-setup.sh 生成，不存在时忽略
EnvironmentFile=-/opt/meng-x/meng-x.env

# 文件日志：Spring Boot 原生映射 logging.file.name，与 journalctl 双写；
# LogsDirectory 由 systemd 自动创建 /var/log/mengx 并 chown 给运行用户；默认每天/10MB 滚动保留 7 天
Environment=LOGGING_FILE_NAME=/var/log/mengx/app.log
LogsDirectory=mengx

[Install]
WantedBy=multi-user.target
